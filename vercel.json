{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" },
    { "source": "/akun", "destination": "/account.html" },
    { "source": "/akun/", "destination": "/account.html" },
    { "source": "/menu/:slug", "destination": "/index.html" },
    { "source": "/menu/:slug/", "destination": "/index.html" }
  ]
}
